<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navera_estimator</name>
  <version>0.0.1</version>
  <description>NAVERA position arbiter — consumes per-source PositionEstimate messages, selects the winning solution and publishes /navera/position + /navera/nav_status.</description>
  <maintainer email="contact@iris-systems.tn">IRIS Systems</maintainer>
  <license>Apache-2.0</license>


  <depend>rclpy</depend>
  <exec_depend>navera_common</exec_depend>
  <depend>launch</depend>
  <depend>launch-ros</depend>
  <depend>sensor_msgs</depend>
  <depend>navera_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
