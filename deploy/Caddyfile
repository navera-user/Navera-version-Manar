# NAVERA Academy — public HTTPS front door (Caddy, user level: no root, high ports).
# The office router forwards  80 → <jetson>:8080  and  443 → <jetson>:8443.
# Let's Encrypt certificates are obtained and renewed automatically (state in state/caddy).
{
	http_port 8080
	https_port 8443
	admin localhost:2019
}

academy.iris-systems.tn {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:8300
}
