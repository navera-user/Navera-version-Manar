[Unit]
Description=NAVERA product firewall: incoming traffic only to the web page, SSH (keys) and the configured MAVLink / ROS ports
# Installed by deploy/install.sh --product (deploy/product/). Not a navera-* unit: it runs as
# root, reads only the root-owned /etc/navera/navera.env, and has no ROS node.
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/navera/navera.env
ExecStart=/usr/local/sbin/navera_firewall.sh
ExecStop=/usr/local/sbin/navera_firewall.sh --stop

[Install]
WantedBy=multi-user.target
