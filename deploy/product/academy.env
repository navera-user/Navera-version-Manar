# /etc/navera-academy/academy.env — NAVERA Academy on the NAVERA box (written by install_academy.sh)
ACADEMY_PRODUCT=1
ACADEMY_VAR=/var/lib/navera-academy
ACADEMY_DATA=/var/lib/navera-academy/data
ACADEMY_PYTHONUSERBASE=/opt/navera-academy/pyuser
PYTHONUSERBASE=/opt/navera-academy/pyuser
ACADEMY_PORT=8300
ACADEMY_HOST=0.0.0.0
# NAVERA's web bridge: GPU training and Sim Lite are refused while NAVERA flies or cannot tell
ACADEMY_NAVERA_STATE_URL=http://127.0.0.1:8181/api/mission/state
# per student sandbox (one AI training peaks at 1.6-1.8 GB) and one GPU training at a time
ACADEMY_MEMORY_MAX=2000M
ACADEMY_HEAVY_MEMORY_MAX=2000M
ACADEMY_GPU_SLOTS_N=1
ACADEMY_SHARED_NETNS=1
PYTHONDONTWRITEBYTECODE=1
