[Unit]
Description=NAVERA hotspot: the box's own Wi-Fi for phones and laptops (navera_hotspot.sh)
# Installed by deploy/install.sh --product (deploy/product/). Runs as root: NetworkManager system connection.
After=NetworkManager.service iris-firewall.service
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/navera/navera.env
ExecStart=/usr/local/sbin/navera_hotspot.sh
ExecStop=/usr/local/sbin/navera_hotspot.sh --stop

[Install]
WantedBy=multi-user.target
