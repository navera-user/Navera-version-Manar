[Unit]
Description=NAVERA access gate: the key check in front of the web page for the public link
# Installed by deploy/install.sh --product (deploy/product/). Listens on 127.0.0.1 only.
After=network.target navera-web.service

[Service]
User=navera
EnvironmentFile=-/etc/navera/navera.env
ExecStart=/usr/bin/python3 /usr/local/lib/navera/navera_access_gate.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
