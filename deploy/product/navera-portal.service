[Unit]
Description=NAVERA setup page (captive portal): put the box on the client's Wi-Fi, open NAVERA
# Installed by deploy/install.sh --product (deploy/product/). The firewall sends the hotspot's port 80 here.
After=network.target navera-wifi.service

[Service]
User=navera
EnvironmentFile=-/etc/navera/navera.env
ExecStart=/usr/bin/python3 /usr/local/lib/navera/navera_portal.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/navera/wifi

[Install]
WantedBy=multi-user.target
