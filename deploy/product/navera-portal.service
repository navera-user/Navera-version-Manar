[Unit]
Description=NAVERA captive portal: phones joining the box's Wi-Fi open NAVERA's page by themselves
# Installed by deploy/install.sh --product (deploy/product/). The firewall sends the hotspot's port 80 here.
After=network.target navera-hotspot.service

[Service]
User=navera
EnvironmentFile=-/etc/navera/navera.env
ExecStart=/usr/bin/python3 /usr/local/lib/navera/navera_portal.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
