[Unit]
Description=NAVERA day localization pipeline (ROS2 + web dashboard :8181)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=navera
Group=navera
WorkingDirectory=/home/navera/isaac_ros_common
ExecStart=/home/navera/navera_boot_day.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
