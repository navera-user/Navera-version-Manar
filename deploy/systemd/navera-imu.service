[Unit]
Description=NAVERA IMU sensor node (BNO085 I2C bus 1 @ 0x4A → /navera/sensors/imu)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=navera
Group=navera
SupplementaryGroups=i2c
WorkingDirectory=/home/navera/isaac_ros_common
ExecStart=/home/navera/navera_boot_imu.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
