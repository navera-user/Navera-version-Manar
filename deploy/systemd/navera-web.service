[Unit]
Description=NAVERA web bridge (ROS→HTTP dashboard :8181, drives the day pipeline over DDS)
# Binds a port: needs the network stack, not a network connection.
After=network.target navera-discover.service
# what is connected is found first (navera-discover); a failed search does not block
Wants=navera-discover.service
# Never give up restarting (the default limit stops after 5 fast failures).
StartLimitIntervalSec=0
# No ordering vs navera-pipeline-day: bridge↔pipeline talk over DDS (discovery-based,
# order-independent) with latched handshake topics, so either may start/restart first.

[Service]
# Site settings shared by all NAVERA units (data paths, ROS_DOMAIN_ID...).
# The leading "-" keeps the unit working if the file does not exist.
EnvironmentFile=-/etc/navera/navera.env
# Settings written by the web page (/mission), loaded after navera.env which they override.
EnvironmentFile=-/var/lib/navera/settings.env
# What navera-discover found at boot, for the settings left to "auto" (loaded last).
EnvironmentFile=-/var/lib/navera/discovered.env
# The pipeline the automatic choice runs now (navera-pipeline-select), loaded last.
EnvironmentFile=-/var/lib/navera/pipeline.env
Type=simple
User=navera
Group=navera
WorkingDirectory=/home/navera/isaac_ros_common
ExecStart=/home/navera/navera_boot_web.sh
# always: `ros2 launch` exits with code 0 even when a node crashed (every node
# has on_exit=Shutdown), so on-failure would never restart it.
Restart=always
RestartSec=10
# Memory (F5 / H-11): not needed to navigate. The OOM killer takes it (and a map being
# generated, its child) first; beyond MemoryHigh it is slowed and pushed to swap, beyond
# MemoryMax its memory goes to swap only: it never takes the pipeline's RAM.
OOMScoreAdjust=500
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=multi-user.target
