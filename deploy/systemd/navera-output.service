[Unit]
Description=NAVERA vehicle output (NMEA GPS emulation + MAVLink GPS_INPUT to the autopilot)
# No network dependency: a vehicle in the field often has none, and all
# NAVERA nodes talk over loopback DDS.
After=local-fs.target navera-discover.service
# what is connected is found first (navera-discover); a failed search does not block
Wants=navera-discover.service
# Never give up restarting (the default limit stops after 5 fast failures).
StartLimitIntervalSec=0
# No ordering vs the source services (navera-gps, navera-pipeline-day, navera-imu…):
# the arbiter consumes their estimate topics over DDS (discovery-based,
# order-independent) and tolerates any source appearing/disappearing BY DESIGN
# (freshness gate + first-class NO_FIX). Same reasoning as navera-web ↔
# navera-pipeline-day — any unit may start/restart first.

[Service]
# Site settings shared by all NAVERA units (data paths, ROS_DOMAIN_ID...).
# The leading "-" keeps the unit working if the file does not exist.
EnvironmentFile=-/etc/navera/navera.env
# Settings written by the web page (/mission), loaded after navera.env which they override.
EnvironmentFile=-/var/lib/navera/settings.env
# What navera-discover found at boot, for the settings left to "auto" (loaded last).
EnvironmentFile=-/var/lib/navera/discovered.env
Type=simple
User=navera
Group=navera
# Serial port to the autopilot (e.g. /dev/ttyUSB0, /dev/ttyTHS2).
SupplementaryGroups=dialout
WorkingDirectory=/home/navera/isaac_ros_common
ExecStart=/home/navera/navera_boot_output.sh
# always: `ros2 launch` exits with code 0 even when a node crashed (every node
# has on_exit=Shutdown), so on-failure would never restart it.
Restart=always
# 1 s: back before the output's 10 s bridge ends (B23); a unit failing at every start backs
# off to 30 s in its wrapper (navera_boot_lib.sh navera_restart_backoff)
RestartSec=1
# Memory (F5 / H-11): a small process NAVERA cannot fly without. The kernel OOM killer
# takes it last (it is never the memory hog), systemd-oomd never picks it.
OOMScoreAdjust=-900
ManagedOOMPreference=omit

[Install]
WantedBy=multi-user.target
