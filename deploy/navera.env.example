# NAVERA site settings — copy to /etc/navera/navera.env and adapt (see deploy/README.md).
#
# Read by every NAVERA systemd unit (EnvironmentFile=). The web page /mission writes a
# few of these keys to /var/lib/navera/settings.env, which is loaded AFTER this file
# and overrides it. A shell used to inspect or test the live system must load both:
#   set -a; . /etc/navera/navera.env; . /var/lib/navera/settings.env 2>/dev/null; . /var/lib/navera/discovered.env 2>/dev/null; set +a
#
# This file holds the web control token: keep it readable by root and navera only
#   sudo chown root:navera /etc/navera/navera.env && sudo chmod 0640 /etc/navera/navera.env
#
# IMPORTANT: a numeric setting must be either set to a value or left COMMENTED OUT.
# "KEY=" with nothing after it is an empty string, not "unset": several launch files
# then fail to start (e.g. NAVERA_DAY_HFOV_DEG=, NAVERA_THERMAL_HFOV_DEG=,
# NAVERA_NMEA_BAUD=, NAVERA_STAR_CAMERA_*=). Lines below that are commented out show
# the default that applies when the key is absent.

# ── ROS 2 network ──────────────────────────────────────────────────────────
# Stand-alone box (sensors on the box, output by serial/MAVLink): keep NAVERA on
# loopback with a domain of its own, so no other ROS 2 machine on the network (a laptop
# running a simulator, another vehicle) can publish into the estimator.
# ROS-based vehicle (NAVERA_SENSOR_SOURCE=ros, NAVERA_GPS_SOURCE=ros, or a ROS consumer
# of /navera/fix): NAVERA must join the vehicle's ROS graph — set ROS_LOCALHOST_ONLY=0
# and ROS_DOMAIN_ID to the vehicle's domain (see deploy/README.md, "ROS vehicles"), or
# ROS_DOMAIN_ID=auto: NAVERA joins the domain of a ROS vehicle navera-discover finds at
# boot, and stays on 42, loopback only, when it finds none (see the caution in
# deploy/README.md §6: writing the vehicle's domain number is the verified way). A
# number written here is never changed by navera-discover.
# navera-discover runs ONCE per boot: a ROS vehicle that starts after NAVERA is not
# found — write its sources below instead of auto, or `sudo systemctl restart
# navera-discover` and then the other NAVERA units.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=1

# ── Vision pipeline ────────────────────────────────────────────────────────
# Which pipeline the web bridge (navera-web) follows: day | night | cn. Enable the
# matching navera-pipeline-* service (day and night never run together).
NAVERA_PIPELINE=day
# true: the day / night pipelines also run while GPS is valid and publish their own
# positions beside it (field recording with navera_tools/record_session.sh). GPS stays
# the position in use while it is valid. Default false.
#NAVERA_SHADOW_MODE=false

# ── Vehicle ─────────────────────────────────────────────────────────────────
# Maximum speed of THIS vehicle, km/h (4-1890) — set it at installation.
# NAVERA refuses any position the vehicle could not have reached at this speed
# (GPS spoofing jump, false vision match): the estimator's GPS plausibility gate
# and the day/night vision motion gates all use it. Too low: real positions of
# a fast vehicle are refused; too high: spoofing goes unnoticed longer.
# Rule of thumb: cruise speed + 50 % (tailwind included). Examples: multirotor
# 108, boat 72, ground robot 36, fixed-wing 250, fast aircraft 1200.
# Unset: each node keeps its own default (estimator 360, vision 108) and logs
# a warning. An invalid value stops the node with an explicit error.
NAVERA_MAX_SPEED_KMH=
# Vehicle type label: drone | plane | boat | robot | other. Used by
# navera_tools/check_box.py to warn about a fixed camera on a fast multirotor.
#NAVERA_VEHICLE_TYPE=drone

# ── Where attitude, height and GPS come from ──────────────────────────────
# auto (default): at every boot navera-discover looks for what is connected — the box's
# IMU and clock (I2C), a GPS receiver and an autopilot on the serial ports (and MAVLink on
# UDP 14550/14551), a ROS vehicle (IMU / GPS / camera topics, domain 0 and ROS_DOMAIN_ID),
# USB and CSI cameras — and picks: attitude box IMU > autopilot > ROS; GPS box receiver >
# autopilot's 2nd GPS > ROS; camera USB > CSI > ROS. It writes its choices to
# /var/lib/navera/discovered.env and its report to /var/lib/navera/discovery.json
# (shown by navera_tools/check_box.py). Write a value instead of "auto" to impose it.
# A ROS vehicle is used only on NAVERA's ROS domain, or with ROS_DOMAIN_ID=auto (above).
# The autopilot's second GPS is used only when its configuration (GPS_TYPE2) says it is a
# real receiver — never the MAVLink-fed GPS NAVERA itself feeds. No GPS found: the GPS
# service stays idle (no default port is opened). Other MAVLink URLs to try:
# NAVERA_DISCOVER_MAVLINK (comma-separated); other ROS domains: NAVERA_DISCOVER_ROS_DOMAINS.
# NAVERA_SENSOR_SOURCE — attitude and height used by the live camera, the night and
# celestial pipelines and the estimator's IMU liveness check:
#   box      NAVERA's own IMU (BNO085, navera-imu) -> /navera/sensors/imu
#   vehicle  the autopilot over MAVLink (enable navera-vehicle-link) -> /navera/vehicle/imu,
#            /navera/vehicle/altitude_agl (rangefinder), /navera/vehicle/relative_alt (baro)
#   ros      the vehicle's ROS topics (NAVERA_ROS_IMU_TOPIC required)
# Box IMU / clock: navera-discover records whether a BNO085 / DS3231 answers on I2C
# (NAVERA_BOX_IMU, NAVERA_BOX_RTC = 1 or 0, and their bus, in discovered.env); without the
# chip navera-imu / navera-rtc stay idle instead of restarting in a loop.
NAVERA_SENSOR_SOURCE=auto
# ROS topics for NAVERA_SENSOR_SOURCE=ros:
#   NAVERA_ROS_IMU_TOPIC       sensor_msgs/Imu (required): orientation in ENU, yaw
#                              referenced to TRUE north (NAVERA applies no declination to
#                              it); 25 Hz or more (check_box WARNs below 25, FAILs below 10);
#                              BEST_EFFORT or RELIABLE publishers are both received
#   NAVERA_ROS_ALTITUDE_TOPIC  sensor_msgs/Range, height above ground (optional)
NAVERA_ROS_IMU_TOPIC=
NAVERA_ROS_ALTITUDE_TOPIC=
#
# NAVERA_GPS_SOURCE — NAVERA's GPS (navera-gps.service). NAVERA always needs a GPS fix
# at start: it is the first position (the prior) every vision pipeline searches around.
#   serial   (default when the key is absent) the box's receiver, NMEA on NAVERA_GPS_PORT /
#            NAVERA_GPS_BAUD
#   vehicle  the autopilot's SECOND GPS (GPS2_RAW), read by navera-vehicle-link and
#            republished from /navera/vehicle/gps2
#   ros      a sensor_msgs/NavSatFix topic of the vehicle: NAVERA_ROS_GPS_TOPIC. Its
#            covariance counts only with a defined covariance type and a sigma >= 1 cm;
#            without one the GPS is DEGRADED ("uncertainty unknown"), never FIX
#   none     written by navera-discover when it finds no GPS: the GPS service stays idle
# NEVER point NAVERA at a position it produces itself: the autopilot's fused position,
# a GPS instance fed by NAVERA's GPS_INPUT/NMEA output, or /navera/fix.
NAVERA_GPS_SOURCE=auto
# with auto, the port and baud the receiver was found on; to impose them:
#NAVERA_GPS_PORT=/dev/ttyTHS1
#NAVERA_GPS_BAUD=9600
NAVERA_ROS_GPS_TOPIC=
#
# MAVLink address of the autopilot port used by navera-vehicle-link (vehicle sources).
# One format for every NAVERA MAVLink setting: serial:/dev/<port>:<baud>, or
# udpin:<ip>:<port>, udpout:<ip>:<port>, tcp:<ip>:<port>. One autopilot port per NAVERA
# connection, or mavlink-router to share one (docs/ARDUPILOT_INTEGRATION.md).
#   e.g. NAVERA_VEHICLE_MAVLINK_URL=serial:/dev/ttyTHS2:921600
NAVERA_VEHICLE_MAVLINK_URL=

# ── Box IMU (navera-imu, NAVERA_SENSOR_SOURCE=box) ─────────────────────────
# How the IMU is mounted on the vehicle: roll,pitch,yaw in degrees (body x forward,
# y left, z up). Default 0,0,0 = aligned with the vehicle. Also settable from /mission.
#NAVERA_IMU_MOUNT_RPY=0,0,0
# Magnetic declination, degrees, east positive. The box IMU gives MAGNETIC north; the
# IMU node turns it into TRUE north with the World Magnetic Model (pygeomag) as soon as
# a position is known, and uses this value until then. Default: none (heading stays
# magnetic until the first position). Also settable from /mission.
#NAVERA_DECLINATION_DEG=3.3

# ── Live camera (NAVERA_CAMERA=live) ──────────────────────────────────────
# replay = recorded frames (demonstration); live = the real camera (camera_pkg live.launch.py)
NAVERA_CAMERA=replay
# usb (e.g. Insta360 ONE R in webcam mode) | csi (Jetson camera; NAVERA_CAMERA_DEVICE = the
# sensor id, default 0) | gst (any GStreamer source: NAVERA_CAMERA_GST_PIPELINE, ending in
# "appsink name=sink", BGR — an IP/RTSP camera, a gimbal's video stream) | ros
NAVERA_CAMERA_INPUT=auto
# Quote it: the "!" would otherwise break a shell that loads this file.
#NAVERA_CAMERA_GST_PIPELINE="rtspsrc location=rtsp://192.168.144.25:8554/main.264 latency=0 ! decodebin ! videoconvert ! video/x-raw,format=BGR ! appsink name=sink drop=true max-buffers=1 sync=false"
# USB camera: prefer the stable name /dev/v4l/by-id/usb-<maker>_<model>_<serial>-video-index0
# over /dev/videoN (the number changes with plug order). Default /dev/video0.
# Left unset, navera-discover picks the USB camera (and warns when there are several);
# written, it is always this one. The star camera (NAVERA_STAR_CAMERA_DEVICE) is never
# picked as the day camera.
#NAVERA_CAMERA_DEVICE=/dev/v4l/by-id/usb-<maker>_<model>_<serial>-video-index0
# Image topic for NAVERA_CAMERA_INPUT=ros (sensor_msgs/Image). Default /vehicle/camera/image_raw.
NAVERA_CAMERA_TOPIC=
NAVERA_CAMERA_SIZE=1920x1080
# The part of the picture that looks at the ground: top, bottom, left, right or x,y,w,h.
# A 360 camera gives both lenses in one picture (Insta360 One R, USB: top / bottom halves
# 1920x540): use the half of the lens pointing down. Calibrate with the same --crop.
#NAVERA_CAMERA_CROP=top
# Frames offered to vision per second (0.05-30). Default 1.
NAVERA_CAMERA_FPS=1
# Lens calibration YAML from navera_tools/calibrate_camera.py (REQUIRED before a real
# test). It records the camera's /dev/v4l/by-id name: the live camera refuses a
# calibration made with another camera, and one made at another resolution.
NAVERA_CAMERA_CALIBRATION=
# Without a calibration: the horizontal field of view of an ideal, distortion-free lens
# (5-170). One of the two is required: check_box FAILs with neither, WARNs with HFOV only.
NAVERA_CAMERA_HFOV_DEG=
# How the camera is mounted (deg): 0,0,0 = looking straight down, image top to the nose.
NAVERA_CAMERA_MOUNT_RPY=0,0,0
# A multirotor at speed tilts (45 deg at 72 km/h in simulation): frames tilted more than
# NAVERA_CAMERA_MAX_TILT_DEG (5-80, default 45) are not used. A gimbal keeps the camera
# level (only the heading is then taken from the attitude):
NAVERA_CAMERA_GIMBAL=false
NAVERA_CAMERA_MAX_TILT_DEG=45
# Fixed camera only (never with a gimbal): a frame taken while the vehicle rotates faster
# than this (deg/s, measured over the 0.2 s before the exposure; 1-360, default 30) is not
# used — a small exposure-stamp error is then degrees of tilt, tens of metres on the ground.
#NAVERA_CAMERA_MAX_RATE_DPS=30
# Exposure -> grab delay (s, 0-2), measured once per camera model (docs/FIELD_TEST_PROCEDURE.md,
# or navera_tools/bench/camera_latency.py --calib <calibration>: stored with the calibration and
# used when this is 0). Insta360 One R 360 module, USB: 0.14 s measured (2026-10-06).
NAVERA_CAMERA_LATENCY_S=0
# Elevation of the take-off site (m above the WGS84 ellipsoid); empty = the first GPS fix.
NAVERA_GROUND_ALTITUDE_M=

# ── Pipeline-specific settings ─────────────────────────────────────────────
# Day camera horizontal field of view (degrees) for REPLAYED frames (also set by the
# /mission page). The live camera states its own field of view in every frame (from the
# calibration or NAVERA_CAMERA_HFOV_DEG), which wins: this key does not set the live camera.
# Absent with replayed frames: DINOv2 retrieval (the former method, see VALIDATION_STATUS).
#NAVERA_DAY_HFOV_DEG=84
# Day matcher: auto (DISK + LightGlue on the GPU when its models load, SIFT as its
# fallback — measured 31/33 real aerial frames vs SIFT 27/33, 0 wrong), learned, local (SIFT
# only), retrieval (DINOv2, former method). install.sh downloads the models into TORCH_HOME.
#NAVERA_DAY_MATCHER=auto
# Thermal camera horizontal field of view (degrees) — required for night positions from
# frames that do not state their own field of view (replayed frames); a frame's own wins.
#NAVERA_THERMAL_HFOV_DEG=84
# Celestial pipeline — star camera mounting on the vehicle (deg): elevation 90 = pointing
# straight up (default 90), azimuth relative to the vehicle's nose (default 0).
#NAVERA_STAR_CAMERA_ELEVATION_DEG=90
#NAVERA_STAR_CAMERA_AZIMUTH_DEG=0
# A LIVE star camera: set its input (same settings as the day camera, prefix
# NAVERA_STAR_CAMERA_: _INPUT, _DEVICE, _SIZE, _FPS, _CALIBRATION, _HFOV_DEG, _GST_PIPELINE).
# Attitude from the IMU at each exposure, time from the clock, prior from NAVERA's last
# position. Unset: the celestial service replays a bundled sample sky (demonstration).
#NAVERA_STAR_CAMERA_INPUT=usb
#NAVERA_STAR_CAMERA_DEVICE=/dev/v4l/by-id/usb-<star camera>-video-index0
#NAVERA_STAR_CAMERA_SIZE=1280x720
#NAVERA_STAR_CAMERA_FPS=0.1
#NAVERA_STAR_CAMERA_HFOV_DEG=60
# Celestial pipeline ONLY, and only when its attitude source reports MAGNETIC north.
# NAVERA's own IMU already reports TRUE north (see NAVERA_DECLINATION_DEG above): leave
# this unset (default 0) with it, or the declination is applied twice.
#NAVERA_MAGNETIC_DECLINATION_DEG=0
# 1-sigma attitude accuracy of the IMU (deg). Sets the celestial fix's stated accuracy
# (~111 km per degree). Default unknown: the fix is published with unknown accuracy.
#NAVERA_ATTITUDE_SIGMA_DEG=0.5

# ── Output to the vehicle (navera-output.service) ─────────────────────────
# NMEA GPS emulation (GGA + RMC) on a serial port. Empty port = off.
NAVERA_NMEA_PORT=
NAVERA_NMEA_BAUD=9600
# MAVLink GPS_INPUT to the autopilot, e.g. serial:/dev/ttyTHS2:921600. Empty: decided by
# navera-discover (an autopilot found: through navera-vehicle-link's relay,
# udpout:127.0.0.1:14650 — one autopilot port is enough; the output then logs an error
# every 30 s while no vehicle link is connected to the autopilot); off: never.
NAVERA_MAVLINK_URL=
# NAVERA's MAVLink system id = the autopilot's own (SYSID_THISMAV / MAV_SYS_ID), written by
# navera-discover when it finds the autopilot; used by both MAVLink nodes. Default 1.
#NAVERA_MAVLINK_SYSID=1
# ROS sensor_msgs/NavSatFix with the same decision. Default /navera/fix; set but EMPTY
# (NAVERA_ROS_FIX_TOPIC=) turns the ROS output off.
#NAVERA_ROS_FIX_TOPIC=/navera/fix
# header.frame_id of /navera/fix: a frame of the vehicle's TF tree (navsat_transform needs
# one it knows). Default navera.
#NAVERA_ROS_FIX_FRAME_ID=navera
# Vision and celestial positions on /navera/fix: sent by default (status FIX with service 0
# = no satellites, the stated accuracy in the covariance), independently of
# NAVERA_FORWARD_DEGRADED; only with a stated accuracy, never with none. false = ROS gets
# "no fix" for them unless NAVERA_FORWARD_DEGRADED is true.
#NAVERA_ROS_FORWARD_DEGRADED=true
# Vision and celestial positions are DEGRADED (accuracy not established on real data):
# by default NOTHING is sent to the AUTOPILOT while NAVERA navigates without GPS.
# To send them over MAVLink, enable forwarding AND state the accuracy the autopilot must
# assume (metres, 1 sigma; the source's own, when worse, is used instead). Only true or
# false (1/0, yes/no, on/off) is accepted: any other value stops the output service. The
# node refuses to start with forwarding on and no accuracy, or an accuracy above 1000 m.
# ArduPilot's EKF3 caps a stated accuracy at 100 m: above 100 m it trusts the position
# MORE than stated (check_box WARNs). Base the value on your own measurements
# (docs/VALIDATION_STATUS.md, docs/FIELD_TEST_PROCEDURE.md).
#NAVERA_FORWARD_DEGRADED=false
#NAVERA_DEGRADED_SIGMA_M=<your measured value, m>
# NMEA carries no accuracy an autopilot uses (ArduPilot fuses an NMEA GPS as a ~0.5 m
# receiver): with forwarding on, degraded positions go over MAVLink and ROS only, and the
# NMEA output says "no fix" for them — unless this is true (a warning is logged; avoid).
#NAVERA_NMEA_FORWARD_DEGRADED=false
# A position measured longer ago than this (s) is not sent. A younger vision / celestial
# position is carried to the present along the ground velocity measured from the recent
# positions, its accuracy grown by the speed error x its age; with no velocity known it is
# sent stamped with its measurement instant, its accuracy grown by the maximum speed
# (NAVERA_MAX_SPEED_KMH) x its age. Default 5.0.
#NAVERA_MAX_MEASUREMENT_AGE_S=5.0

# ── State kept across a service restart ───────────────────────────────────
# Ground altitude (kept 12 h, reused within 2 km) and day vision's last position
# (kept 5 min) survive a restart in flight. Default /var/lib/navera when writable by the
# service user, else ~/.local/state/navera.
#NAVERA_STATE_DIR=/var/lib/navera

# ── Data (large files, not in git) ─────────────────────────────────────────
# On the data disk mounted at /data (deploy/README.md §3.10). A pipeline whose files are
# missing (disk not mounted) waits and retries every 10 s.
NAVERA_MBTILES=/data/navera/sousse_satellite.mbtiles
DAY_DATASET_DIR=/data/navera/day_dataset
NAVERA_STHN_DIR=/data/navera/STHN
NAVERA_STHN_WEIGHTS=/data/navera/STHN/weights/one_stage/model.safetensors
# Model caches (DINOv2). Pre-fill them: the vehicle may boot without internet.
TORCH_HOME=/data/navera/torch_cache

# ── Mission maps (page /mission) ────────────────────────────────────────────
# Where the satellite maps of routes are generated (one folder per route). The page's
# "Activate" points DAY_DATASET_DIR at one of them (in /var/lib/navera/settings.env).
NAVERA_AREAS_DIR=/data/navera/areas
# Tiles of a route missing from NAVERA_MBTILES are downloaded from this source when set
# (an XYZ template with {z} {x} {y}; internet needed while generating). Empty = onboard
# map only. The imagery provider's licence must allow storing its tiles offline in a
# product: check it before setting this (docs/VALIDATION_STATUS.md, limitation 5).
NAVERA_TILE_URL=
NAVERA_TILE_CACHE=/data/navera/areas/downloaded_tiles.mbtiles

# ── Web interface (navera-web, port 8181) ──────────────────────────────────
# Token required by every control action (mission start, /mission changes), sent in
# the X-Navera-Token header. Empty = the web interface is read-only. After 5 wrong codes
# in 60 s an address is refused for 60 s.
# Generate one with:  openssl rand -hex 16
NAVERA_WEB_TOKEN=
# HTTPS (recommended whenever a token is set: over plain HTTP the token crosses the
# network in clear). Both empty = plain HTTP. Self-signed certificate for the box
# (browsers will ask to trust it once):
#   sudo openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=navera" \
#     -keyout /etc/navera/tls.key -out /etc/navera/tls.crt
#   sudo chown navera:navera /etc/navera/tls.key && sudo chmod 600 /etc/navera/tls.key
NAVERA_TLS_CERT=
NAVERA_TLS_KEY=
# Port of the operator view / dashboard. Keep 8181 on a box; another value only for a
# staged test beside a running box (deploy/stage_check.sh).
#NAVERA_WEB_PORT=8181
