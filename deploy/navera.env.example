# NAVERA site settings — copy to /etc/navera/navera.env and adapt (see deploy/README.md).
#
# Read by every NAVERA systemd unit (EnvironmentFile=). The web page /mission writes a
# few of these keys to /var/lib/navera/settings.env, which is loaded AFTER this file
# and overrides it. A shell used to inspect or test the live system must load both:
#   set -a; . /etc/navera/navera.env; . /var/lib/navera/settings.env 2>/dev/null; . /var/lib/navera/discovered.env 2>/dev/null; set +a
#
# This file holds the web control token: keep it readable by root and navera only
#   sudo chown root:navera /etc/navera/navera.env && sudo chmod 0640 /etc/navera/navera.env
#
# IMPORTANT: a numeric setting must be either set to a value or left COMMENTED OUT.
# "KEY=" with nothing after it is an empty string, not "unset": several launch files
# then fail to start (e.g. NAVERA_DAY_HFOV_DEG=, NAVERA_THERMAL_HFOV_DEG=,
# NAVERA_NMEA_BAUD=, NAVERA_STAR_CAMERA_*=). Lines below that are commented out show
# the default that applies when the key is absent.

# ── ROS 2 network ──────────────────────────────────────────────────────────
# Stand-alone box (sensors on the box, output by serial/MAVLink): keep NAVERA on
# loopback with a domain of its own, so no other ROS 2 machine on the network (a laptop
# running a simulator, another vehicle) can publish into the estimator.
# ROS-based vehicle (NAVERA_SENSOR_SOURCE=ros, NAVERA_GPS_SOURCE=ros, or a ROS consumer
# of /navera/fix): NAVERA must join the vehicle's ROS graph — set ROS_LOCALHOST_ONLY=0
# and ROS_DOMAIN_ID to the vehicle's domain (see deploy/README.md, "ROS vehicles"), or
# ROS_DOMAIN_ID=auto: navera-discover looks for a ROS vehicle on domain 0 and
# NAVERA_DISCOVER_ROS_DOMAINS at boot; found, it writes its domain and ROS_LOCALHOST_ONLY=0
# in /var/lib/navera/discovered.env (loaded by every other unit after this file); none
# found, NAVERA runs on 42, loopback only. Verified by unit tests only, not yet on a real
# vehicle network (deploy/README.md §6): a known domain number is the deterministic way. A
# number written here is never changed by navera-discover.
# navera-discover runs ONCE per boot: a ROS vehicle that starts after NAVERA is not
# found — write its sources below instead of auto, or `sudo systemctl restart
# navera-discover` and then the other NAVERA units.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=1

# ── Vision pipeline ────────────────────────────────────────────────────────
# Which pipeline the web bridge (navera-web) follows: day | night | cn. Enable the
# matching navera-pipeline-* service (day and night never run together).
NAVERA_PIPELINE=day
# true: the day / night pipelines also run while GPS is valid and publish their own
# positions beside it (field recording with navera_tools/record_session.sh). GPS stays
# the position in use while it is valid. Default false.
#NAVERA_SHADOW_MODE=false

# ── Vehicle ─────────────────────────────────────────────────────────────────
# Maximum speed of THIS vehicle, km/h (4-1890) — set it at installation.
# NAVERA refuses any position the vehicle could not have reached at this speed
# (GPS spoofing jump, false vision match): the estimator's GPS plausibility gate
# and the day/night vision motion gates all use it. Too low: real positions of
# a fast vehicle are refused; too high: spoofing goes unnoticed longer.
# Rule of thumb: cruise speed + 50 % (tailwind included). Examples: multirotor
# 108, boat 72, ground robot 36, fixed-wing 250, fast aircraft 1200.
# Unset: each node keeps its own default (estimator 360, vision 108) and logs
# a warning. An invalid value stops the node with an explicit error.
NAVERA_MAX_SPEED_KMH=
# Vehicle type label: drone | plane | boat | robot | other. Used by
# navera_tools/check_box.py to warn about a fixed camera on a fast multirotor.
#NAVERA_VEHICLE_TYPE=drone

# ── Where attitude, height and GPS come from ──────────────────────────────
# auto (default): at every boot navera-discover looks for what is connected — the box's
# IMU and clock (I2C); GPS receivers: NMEA or u-blox UBX on the serial ports (a USB GPS, the
# box's UART, or a passive tap on the TX wire of the GPS the autopilot uses), DroneCAN GNSS
# (Here3/Here4...) on the CAN interfaces that are up, NMEA/UBX on NAVERA_DISCOVER_GPS_URLS;
# an autopilot (MAVLink on the serial ports, UDP 14550/14551, TCP 127.0.0.1:5760 and
# NAVERA_DISCOVER_MAVLINK); a ROS vehicle (IMU / GPS / camera topics, domain 0 and
# ROS_DOMAIN_ID); USB and CSI cameras, an Insta360 One R in USB "Android" mode (USB id
# 2e1a:0002) — and picks: attitude box IMU > autopilot > ROS > the Insta360's own IMU; GPS
# serial receiver > DroneCAN > network > autopilot's 2nd GPS > autopilot's 1st GPS > ROS;
# camera Insta360 (Android mode) > USB > CSI > ROS. It writes its choices to
# /var/lib/navera/discovered.env and its report to /var/lib/navera/discovery.json (shown by navera_tools/check_box.py). Write a value
# instead of "auto" to impose it. A ROS vehicle is used only on NAVERA's ROS domain, or with
# ROS_DOMAIN_ID=auto (above). An autopilot's GPS is used only when its configuration
# (GPS_TYPE / GPS_TYPE2) says it is a real receiver — never the MAVLink-fed GPS (type 14) NAVERA
# itself feeds, nor an NMEA GPS (type 5) while NAVERA's NMEA output is on. No GPS found: the
# GPS service stays idle (no default port is opened) and navera-hotplug keeps looking: a GPS,
# autopilot or camera connected later fills what is missing (never a working source, the GPS
# never while the vehicle is armed). Probing only reads: a receiver is never configured.
# Other MAVLink URLs to try: NAVERA_DISCOVER_MAVLINK (comma-separated); other ROS domains:
# NAVERA_DISCOVER_ROS_DOMAINS.
#NAVERA_DISCOVER_MAVLINK=tcp:192.168.144.10:5760
# GPS streams on the network to try (comma-separated): tcp:<host>:<port> (NAVERA connects),
# tcp:<host> (the common ports 10110, 2000, 4001 of that host), udp:<port> or udp (10110,
# NAVERA listens). Nothing by default: NAVERA never connects to an address it was not given.
#NAVERA_DISCOVER_GPS_URLS=tcp:192.168.1.50,udp:10110
# Extra CAN buses for DroneCAN (pydronecan addresses), e.g. a USB-CAN adapter in SLCAN mode.
# SocketCAN interfaces (can0) are found by themselves once they are up — bringing can0 up
# needs root: sudo ip link set can0 up type can bitrate 1000000 (deploy/README.md).
#NAVERA_DISCOVER_CAN=slcan:/dev/ttyACM1
# navera-hotplug (default 1): fill idle sources when a device is connected after boot; 0 = off.
# While no GPS is found it also listens again to the silent ports and buses every
# NAVERA_HOTPLUG_RESCAN_S seconds (default 60).
#NAVERA_HOTPLUG=1
#NAVERA_HOTPLUG_RESCAN_S=60
# NAVERA_SENSOR_SOURCE — attitude and height used by the live camera, the night and
# celestial pipelines and the estimator's IMU liveness check:
#   box      NAVERA's own IMU (BNO085, navera-imu) -> /navera/sensors/imu
#   vehicle  the autopilot over MAVLink (enable navera-vehicle-link) -> /navera/vehicle/imu,
#            /navera/vehicle/altitude_agl (rangefinder), /navera/vehicle/relative_alt (baro)
#   ros      the vehicle's ROS topics (NAVERA_ROS_IMU_TOPIC required)
#   insta360 the Insta360 One R's own IMU (the Insta360 kit, navera-insta360) ->
#            /navera/sensors/insta360/imu: roll / pitch from its gyro + accelerometer, yaw from its
#            gyro set by the GPS course and by vision (no magnetometer); no rangefinder / barometer
# Box IMU / clock: navera-discover records whether a BNO085 / DS3231 answers on I2C
# (NAVERA_BOX_IMU, NAVERA_BOX_RTC = 1 or 0, and their bus, in discovered.env); without the
# chip navera-imu / navera-rtc stay idle instead of restarting in a loop.
NAVERA_SENSOR_SOURCE=auto
# ROS topics for NAVERA_SENSOR_SOURCE=ros:
#   NAVERA_ROS_IMU_TOPIC       sensor_msgs/Imu (required): orientation in ENU, yaw
#                              referenced to TRUE north (NAVERA applies no declination to
#                              it); 25 Hz or more (check_box WARNs below 25, FAILs below 10);
#                              BEST_EFFORT or RELIABLE publishers are both received
#   NAVERA_ROS_ALTITUDE_TOPIC  sensor_msgs/Range, height above ground (optional)
NAVERA_ROS_IMU_TOPIC=
NAVERA_ROS_ALTITUDE_TOPIC=
#
# NAVERA_GPS_SOURCE — NAVERA's GPS (navera-gps.service). NAVERA always needs a GPS fix
# at start: it is the first position (the prior) every vision pipeline searches around.
#   serial       (default when the key is absent) a receiver on a serial port — NMEA and/or
#                u-blox UBX (NAV-PVT), recognised automatically — on NAVERA_GPS_PORT /
#                NAVERA_GPS_BAUD; also a passive tap (Y-cable) on the TX wire of the GPS the
#                autopilot uses (ArduPilot sets a u-blox to UBX at 230400)
#   network      NMEA / UBX over the network: NAVERA_GPS_URL = tcp:<host>:<port> (NAVERA
#                connects) or udp:<port> (NAVERA listens)
#   dronecan     a DroneCAN GNSS (uavcan.equipment.gnss.Fix2: Here3/Here4, Holybro...) on
#                NAVERA_GPS_CAN_IFACE (default can0; or slcan:/dev/ttyACM0), node
#                NAVERA_GPS_CAN_NODE (default 0 = the first one heard with a fix). Passive:
#                NAVERA sends nothing on the bus. Needs the pip package dronecan.
#   vehicle      the autopilot's SECOND GPS (GPS2_RAW), read by navera-vehicle-link and
#                republished from /navera/vehicle/gps2
#   vehicle_gps1 the autopilot's FIRST GPS (GPS_RAW_INT), read by navera-vehicle-link only
#                while the autopilot says NAVERA does not feed it (GPS_TYPE not 14, nor 5 with
#                NAVERA's NMEA output on): wiring where NAVERA is the autopilot's GPS2
#   ros          a sensor_msgs/NavSatFix topic of the vehicle: NAVERA_ROS_GPS_TOPIC. Its
#                covariance counts only with a defined covariance type and a sigma >= 1 cm;
#                without one the GPS is DEGRADED ("uncertainty unknown"), never FIX
#   none         written by navera-discover when it finds no GPS: the GPS service stays idle
#                until navera-hotplug finds one
# NEVER point NAVERA at a position it produces itself: the autopilot's fused position,
# a GPS instance fed by NAVERA's GPS_INPUT/NMEA output, or /navera/fix.
NAVERA_GPS_SOURCE=auto
# with auto, the port and baud the receiver was found on; to impose them:
#NAVERA_GPS_PORT=/dev/ttyTHS1
#NAVERA_GPS_BAUD=9600
# network GPS (NAVERA_GPS_SOURCE=network), e.g. tcp:192.168.1.50:10110 or udp:10110
#NAVERA_GPS_URL=
# DroneCAN GPS (NAVERA_GPS_SOURCE=dronecan): the bus and the node (0 = the first with a fix)
#NAVERA_GPS_CAN_IFACE=can0
#NAVERA_GPS_CAN_NODE=0
# 1: NAVERA gives DroneCAN node ids (a GPS alone on NAVERA's CAN, with no autopilot to give
# it one). NAVERA then transmits on the bus as node 125. Default 0: listen only.
#NAVERA_GPS_CAN_ALLOCATE=0
# 1: NAVERA may configure the receiver (serial / TCP): it turns on UBX NAV-PVT and NAV-DOP in
# the receiver's RAM (lost at power-off). Only for a receiver NAVERA owns. Default 0: NAVERA
# never writes to a GPS.
#NAVERA_GPS_CONFIGURE=0
# 0: never use the autopilot's first GPS (vehicle_gps1), even when discovery could. Default auto.
#NAVERA_GPS_MONITOR_GPS1=auto
NAVERA_ROS_GPS_TOPIC=
#
# MAVLink address of the autopilot port used by navera-vehicle-link (vehicle sources).
# One format for every NAVERA MAVLink setting: serial:/dev/<port>:<baud>, or
# udpin:<ip>:<port>, udpout:<ip>:<port>, tcp:<ip>:<port>. One autopilot port per NAVERA
# connection, or mavlink-router to share one (docs/ARDUPILOT_INTEGRATION.md).
#   e.g. NAVERA_VEHICLE_MAVLINK_URL=serial:/dev/ttyTHS2:921600
NAVERA_VEHICLE_MAVLINK_URL=

# ── Box IMU (navera-imu, NAVERA_SENSOR_SOURCE=box) ─────────────────────────
# How the IMU is mounted on the vehicle: roll,pitch,yaw in degrees (body x forward,
# y left, z up). Default 0,0,0 = aligned with the vehicle. Also settable from /mission.
#NAVERA_IMU_MOUNT_RPY=0,0,0
# Magnetic declination, degrees, east positive. The box IMU gives MAGNETIC north; the
# IMU node turns it into TRUE north with the World Magnetic Model (pygeomag) as soon as
# a position is known, and uses this value until then. Default: none (heading stays
# magnetic until the first position). Also settable from /mission.
#NAVERA_DECLINATION_DEG=3.3

# ── The Insta360 kit (navera-insta360) ────────────────────────────────────
# Used when NAVERA_SENSOR_SOURCE or NAVERA_CAMERA_INPUT is insta360 (navera-discover chooses it
# when it finds the One R in USB "Android" mode; the service idles otherwise). ONE process owns
# the camera: not with the field server (navera-field) or the camera in webcam mode.
# How the camera is mounted: its IMU axes along the vehicle's x (forward), y (left), z (up).
# Camera IMU frame: +x = the camera's top (up when it stands), +y = the LEFT lens' optical axis,
# +z = x cross y. Default +x,+z,-y: LYING, the left lens looking straight DOWN, the camera's top
# towards the nose (the only good mount for day vision: straight down is the lens' centre).
#NAVERA_INSTA360_MOUNT_AXES=+x,+z,-y
# A small trim after the axes, roll,pitch,yaw deg (within +-30), measured on the vehicle:
#NAVERA_INSTA360_MOUNT_RPY=0,0,0
# The straight-down view cut from the down lens: size and width (30-140 deg; default 1200x900,
# 100 deg = the screen-bench configuration, 151/152 frames matched on 2026-10-17).
#NAVERA_INSTA360_VIEW_SIZE=1200x900
#NAVERA_INSTA360_VIEW_HFOV_DEG=100
# Calibration files (copied from the bench, navera_tools/bench/lens_calib_wide.py and the
# 6-position IMU calibration). Default: /var/lib/navera/insta360_lens.json, then
# ~/.navera_sim/insta360_usb_lens.json; IMU ~/.navera_sim/insta360_usb_imu.json.
#NAVERA_INSTA360_LENS=/var/lib/navera/insta360_lens.json
#NAVERA_INSTA360_IMU=/var/lib/navera/insta360_imu.json

# ── Live camera (NAVERA_CAMERA=live) ──────────────────────────────────────
# replay = recorded frames (demonstration); live = the real camera (camera_pkg live.launch.py)
NAVERA_CAMERA=replay
# usb (a UVC camera; the Insta360 ONE R in webcam mode gives only cropped strips) | csi (Jetson
# camera; NAVERA_CAMERA_DEVICE = the sensor id, default 0) | gst (any GStreamer source:
# NAVERA_CAMERA_GST_PIPELINE, ending in "appsink name=sink", BGR — an IP/RTSP camera, a gimbal's
# video stream) | ros | insta360 (the Insta360 kit: the One R in USB "Android" mode, read by
# navera-insta360, which cuts a straight-down view out of its 360 picture: no
# NAVERA_CAMERA_CALIBRATION / _CROP / _MOUNT_RPY / _SIZE — see the Insta360 kit section below)
NAVERA_CAMERA_INPUT=auto
# Quote it: the "!" would otherwise break a shell that loads this file.
# The box decodes H.264 / H.265 in hardware (nvv4l2decoder); it has no h264parse nor software
# decoder (gstreamer1.0-plugins-bad / -libav are not installed), so "decodebin" finds NO decoder for
# an RTSP camera and the camera never delivers a frame (measured 2026-10-22, hardware-in-the-loop
# test). Give the decoder byte-stream caps as below; an H.265 camera: rtph265depay !
# video/x-h265,stream-format=byte-stream,alignment=au ! nvv4l2decoder.
#NAVERA_CAMERA_GST_PIPELINE="rtspsrc location=rtsp://192.168.144.25:8554/main.264 latency=0 ! rtph264depay ! video/x-h264,stream-format=byte-stream,alignment=au ! nvv4l2decoder ! nvvidconv ! video/x-raw,format=BGRx ! videoconvert ! video/x-raw,format=BGR ! appsink name=sink drop=true max-buffers=1 sync=false"
# USB camera: prefer the stable name /dev/v4l/by-id/usb-<maker>_<model>_<serial>-video-index0
# over /dev/videoN (the number changes with plug order). Default /dev/video0.
# Left unset, navera-discover picks the USB camera (and warns when there are several);
# written, it is always this one. The star camera (NAVERA_STAR_CAMERA_DEVICE) is never
# picked as the day camera.
#NAVERA_CAMERA_DEVICE=/dev/v4l/by-id/usb-<maker>_<model>_<serial>-video-index0
# Plug and play (docs/USER_MANUAL.md §6.0): navera-discover finds every camera — USB, CSI, network
# (ONVIF, common gimbal cameras), ROS topics — tells colour / thermal and ground / sky, and fills
# the day (NAVERA_CAMERA_*), thermal (NAVERA_THERMAL_CAMERA_*, night vision) and star
# (NAVERA_STAR_CAMERA_*) settings left unset here, with the camera's size, format and a starting
# field of view (the lens is then calibrated in flight, §6.2). Network cameras with a login:
#NAVERA_IP_CAMERA_USER=admin
#NAVERA_IP_CAMERA_PASSWORD=
# (never copied into discovered.env: the pipeline there says @NAVERA_IP_CAMERA_PASSWORD@).
# 0: do not look for network cameras; wifi: also on Wi-Fi (default wired only: an office or hangar
# Wi-Fi's security cameras would answer like the vehicle's own).
#NAVERA_DISCOVER_IP_CAMERAS=1
# 0: do not ask the hosts of the wired subnet for an RTSP stream (cameras without ONVIF).
#NAVERA_DISCOVER_RTSP_SCAN=1
# URLs fetched (in order) before a gst stream opens: a camera that streams only once told to
# (written by navera-discover for a GoPro on USB). NAVERA_CAMERA_INPUT=aravis: a GigE Vision /
# USB3 Vision camera, NAVERA_CAMERA_DEVICE = its Aravis id (arv-tool-0.8 lists them).
#NAVERA_CAMERA_START_URL=
# Image topic for NAVERA_CAMERA_INPUT=ros (sensor_msgs/Image). Default /vehicle/camera/image_raw.
NAVERA_CAMERA_TOPIC=
NAVERA_CAMERA_SIZE=1920x1080
# auto: a network stream's / ROS topic's own size. USB picture format (Y16 / GREY: a thermal core):
#NAVERA_CAMERA_FOURCC=MJPG
# The part of the picture that looks at the ground: top, bottom, left, right or x,y,w,h.
# A 360 camera gives both lenses in one picture (Insta360 One R, USB: top / bottom halves
# 1920x540): use the half of the lens pointing down. Calibrate with the same --crop.
#NAVERA_CAMERA_CROP=top
# Frames offered to vision per second (0.05-30). Default 1.
NAVERA_CAMERA_FPS=1
# Bench lens calibration YAML from navera_tools/calibrate_camera.py (optional). It records the
# camera's /dev/v4l/by-id name: the live camera refuses a calibration made with another camera,
# and one made at another resolution. A file here always wins.
NAVERA_CAMERA_CALIBRATION=
# Without a calibration file: the STARTING field of view of an ideal lens (5-170; navera-discover
# writes the camera list's value, else 70). The day pipeline then calibrates the lens in flight
# while the GPS is trusted (day_subscriber lens_selfcal, on by default) and keeps it for this camera.
NAVERA_CAMERA_HFOV_DEG=
# How the camera is mounted (deg): 0,0,0 = looking straight down, image top to the nose.
NAVERA_CAMERA_MOUNT_RPY=0,0,0
# A multirotor at speed tilts (45 deg at 72 km/h in simulation): frames tilted more than
# NAVERA_CAMERA_MAX_TILT_DEG (5-80, default 45) are not used. A gimbal keeps the camera
# level (only the heading is then taken from the attitude):
NAVERA_CAMERA_GIMBAL=false
NAVERA_CAMERA_MAX_TILT_DEG=45
# Fixed camera only (never with a gimbal): a frame taken while the vehicle rotates faster
# than this (deg/s, measured over the 0.2 s before the exposure; 1-360, default 30) is not
# used — a small exposure-stamp error is then degrees of tilt, tens of metres on the ground.
#NAVERA_CAMERA_MAX_RATE_DPS=30
# Exposure -> grab delay (s, 0-2), measured once per camera model (docs/FIELD_TEST_PROCEDURE.md,
# or navera_tools/bench/camera_latency.py --calib <calibration>: stored with the calibration and
# used when this is 0). Insta360 One R 360 module, USB: 0.14 s measured (2026-10-06).
# This is the STARTING value: the day pipeline also learns the delay in flight while the GPS
# is trusted (day_subscriber parameter auto_latency, ON by default — no key in this file;
# needs turns / speed changes; replaces this value only when stable and clearly different;
# deploy/README.md §4). Night and celestial use this value as written.
NAVERA_CAMERA_LATENCY_S=0
# Elevation of the take-off site (m above the WGS84 ellipsoid); empty = the first GPS fix.
NAVERA_GROUND_ALTITUDE_M=

# ── Pipeline-specific settings ─────────────────────────────────────────────
# Day camera horizontal field of view (degrees) for REPLAYED frames (also set by the
# /mission page). The live camera states its own field of view in every frame (from the
# calibration or NAVERA_CAMERA_HFOV_DEG), which wins: this key does not set the live camera.
# Absent with replayed frames: DINOv2 retrieval (the former method, see VALIDATION_STATUS).
#NAVERA_DAY_HFOV_DEG=84
# Day matcher: auto (DISK + LightGlue on the GPU when its models load, SIFT as its
# fallback — measured 31/33 real aerial frames vs SIFT 27/33, 0 wrong), learned, local (SIFT
# only), retrieval (DINOv2, former method). install.sh downloads the models into TORCH_HOME.
#NAVERA_DAY_MATCHER=auto
# Thermal camera horizontal field of view (degrees) — required for night positions from
# frames that do not state their own field of view (replayed frames); a frame's own wins.
#NAVERA_THERMAL_HFOV_DEG=84
# Celestial pipeline — star camera mounting on the vehicle (deg): elevation 90 = pointing
# straight up (default 90), azimuth relative to the vehicle's nose (default 0).
#NAVERA_STAR_CAMERA_ELEVATION_DEG=90
#NAVERA_STAR_CAMERA_AZIMUTH_DEG=0
# A LIVE star camera: set its input (same settings as the day camera, prefix
# NAVERA_STAR_CAMERA_: _INPUT, _DEVICE, _SIZE, _FPS, _CALIBRATION, _HFOV_DEG, _GST_PIPELINE).
# Attitude from the IMU at each exposure, time from the clock, prior from NAVERA's last
# position. Unset: the celestial service replays a bundled sample sky (demonstration).
#NAVERA_STAR_CAMERA_INPUT=usb
#NAVERA_STAR_CAMERA_DEVICE=/dev/v4l/by-id/usb-<star camera>-video-index0
#NAVERA_STAR_CAMERA_SIZE=1280x720
#NAVERA_STAR_CAMERA_FPS=0.1
#NAVERA_STAR_CAMERA_HFOV_DEG=60
# Celestial pipeline ONLY, and only when its attitude source reports MAGNETIC north.
# NAVERA's own IMU already reports TRUE north (see NAVERA_DECLINATION_DEG above): leave
# this unset (default 0) with it, or the declination is applied twice.
#NAVERA_MAGNETIC_DECLINATION_DEG=0
# 1-sigma attitude accuracy of the IMU (deg). Sets the celestial fix's stated accuracy
# (~111 km per degree). Default unknown: the fix is published with unknown accuracy.
#NAVERA_ATTITUDE_SIGMA_DEG=0.5

# ── Output to the vehicle (navera-output.service) ─────────────────────────
# NMEA GPS emulation (GGA + RMC) on a serial port. Empty port = off.
NAVERA_NMEA_PORT=
NAVERA_NMEA_BAUD=9600
# nmea (default) or ubx: NAVERA as a u-blox GPS module (PX4, INAV, Betaflight, ArduPilot GPS_TYPE=2;
# manual §5.5). UBX carries the accuracy: vision positions go out under NAVERA_FORWARD_DEGRADED.
#NAVERA_NMEA_PROTOCOL=nmea
# satellites stated in UBX with a vision position (INAV/Betaflight refuse fewer than their minimum)
#NAVERA_UBX_ESTIMATED_SATELLITES=0
# MAVLink GPS_INPUT to the autopilot, e.g. serial:/dev/ttyTHS2:921600. Empty: decided by
# navera-discover (an autopilot found: through navera-vehicle-link's relay,
# udpout:127.0.0.1:14650 — one autopilot port is enough; the output then logs an error
# every 30 s while no vehicle link is connected to the autopilot); off: never.
NAVERA_MAVLINK_URL=
# NAVERA's MAVLink system id = the autopilot's own (SYSID_THISMAV / MAV_SYS_ID), written by
# navera-discover when it finds the autopilot; used by both MAVLink nodes. Default 1.
#NAVERA_MAVLINK_SYSID=1
# The MAVLink position message: gps_input (ArduPilot, GPS_TYPE = 14) | hil_gps (PX4: it has no
# GPS_INPUT handler and reads HIL_GPS as a GPS with MAV_USEHILGPS = 1 — docs/PX4_INTEGRATION.md
# lists the EKF2 / commander parameters it then needs) | auto (default: HIL_GPS once the autopilot's
# heartbeat says PX4, else GPS_INPUT; navera-discover writes hil_gps when it finds PX4).
#NAVERA_MAVLINK_MESSAGE=auto
# ROS sensor_msgs/NavSatFix with the same decision. Default /navera/fix; set but EMPTY
# (NAVERA_ROS_FIX_TOPIC=) turns the ROS output off.
#NAVERA_ROS_FIX_TOPIC=/navera/fix
# header.frame_id of /navera/fix: a frame of the vehicle's TF tree (navsat_transform needs
# one it knows). Default navera.
#NAVERA_ROS_FIX_FRAME_ID=navera
# Vision and celestial positions on /navera/fix: sent by default (status FIX with service 0
# = no satellites, the stated accuracy in the covariance), independently of
# NAVERA_FORWARD_DEGRADED; only with a stated accuracy, never with none. false = ROS gets
# "no fix" for them unless NAVERA_FORWARD_DEGRADED is true.
#NAVERA_ROS_FORWARD_DEGRADED=true
# Vision and celestial positions are DEGRADED (accuracy not established on real data):
# by default NOTHING is sent to the AUTOPILOT while NAVERA navigates without GPS: at a GPS
# loss the autopilot gets "no fix" and ITS OWN failsafe acts (ArduPilot SITL: Copter LAND,
# Rover HOLD) — configure that failsafe. Enable forwarding only with ArduPilot configured
# as in docs/ARDUPILOT_INTEGRATION.md, an accuracy MEASURED on this vehicle (shadow-mode
# flights with GPS), a route over ground vision can match, and a safety pilot for the first
# GPS-denied flights (deploy/README.md §7, "When to enable forwarding").
# To send them over MAVLink, enable forwarding AND state the accuracy the autopilot must
# assume (metres, 1 sigma; the source's own, when worse, is used instead). Only true or
# false (1/0, yes/no, on/off) is accepted: any other value stops the output service. The
# node refuses to start with forwarding on and no accuracy, or an accuracy above 1000 m.
# ArduPilot's EKF3 caps a stated accuracy at 100 m: above 100 m it trusts the position
# MORE than stated (check_box WARNs). Base the value on your own measurements
# (docs/VALIDATION_STATUS.md, docs/FIELD_TEST_PROCEDURE.md).
#NAVERA_FORWARD_DEGRADED=false
#NAVERA_DEGRADED_SIGMA_M=<your measured value, m>
# NMEA carries no accuracy an autopilot uses (ArduPilot fuses an NMEA GPS as a ~0.5 m
# receiver): with forwarding on, degraded positions go over MAVLink and ROS only, and the
# NMEA output says "no fix" for them — unless this is true (a warning is logged; avoid).
#NAVERA_NMEA_FORWARD_DEGRADED=false
# A position measured longer ago than this (s) is not sent. A younger vision / celestial
# position is carried to the present along the ground velocity measured from the recent
# positions, its accuracy grown by the speed error x its age; with no velocity known it is
# sent stamped with its measurement instant, its accuracy grown by the maximum speed
# (NAVERA_MAX_SPEED_KMH) x its age. Default 5.0.
#NAVERA_MAX_MEASUREMENT_AGE_S=5.0
# A gap in the forwarded vision positions is bridged this long at most (s): the last one is
# carried along its velocity and re-sent once a second, its accuracy growing; then "no fix".
# 0 = never. A copter needs it (EKF3 times out ~8 s into a silence); a fixed-wing with an
# airspeed sensor dead-reckons better on its own: 0 recommended there (ArduPlane SITL,
# docs/ARDUPILOT_INTEGRATION.md §3). Default 10.
#NAVERA_BRIDGE_MAX_S=10

# ── State kept across a service restart ───────────────────────────────────
# Ground altitude (kept 12 h, reused within 2 km) and day vision's last position
# (kept 5 min) survive a restart in flight. Default /var/lib/navera when writable by the
# service user, else ~/.local/state/navera.
#NAVERA_STATE_DIR=/var/lib/navera

# ── ROS logs (pruned at every unit start) ─────────────────────────────────
# Log folders older than 7 days go, then the oldest until the folder is under
# NAVERA_LOG_MAX_MB (a restart loop makes one folder per 10 s); a warning when the log disk
# has less than NAVERA_MIN_FREE_MB free.
#NAVERA_LOG_MAX_MB=1024
#NAVERA_MIN_FREE_MB=2048
# Swap on disk (F5: the day pipeline was OOM-killed on the 8 GB Jetson without it). install.sh
# makes NAVERA_SWAP_MB at /swapfile when less than NAVERA_MIN_SWAP_MB is active
# (deploy/setup_swap.sh); each pipeline start and check_boot.sh warn below NAVERA_MIN_SWAP_MB.
# JetPack's zram is in RAM and does not count.
#NAVERA_SWAP_MB=8192
#NAVERA_MIN_SWAP_MB=4096

# ── Data (large files, not in git) ─────────────────────────────────────────
# On the data disk mounted at /data (deploy/README.md §3.10). A pipeline whose files are
# missing (disk not mounted) waits and retries every 10 s.
# LICENCE WARNING (docs/research/map_licensing_2026-10-21.md): the delivered Sousse sample
# map is presumed Esri World Imagery, and Esri's terms forbid storing its tiles offline
# outside licensed ArcGIS apps. It is for development and IRIS-internal demos only: do not
# ship it (or any Esri-built map) on a sold device or a demo unit leaving IRIS. A product
# needs imagery licensed for offline storage on the device (e.g. Airbus, or imagery the
# customer licenses itself); free Sentinel-2 (10 m) is legal but too coarse for day matching.
NAVERA_MBTILES=/data/navera/sousse_satellite.mbtiles
DAY_DATASET_DIR=/data/navera/day_dataset
NAVERA_STHN_DIR=/data/navera/STHN
NAVERA_STHN_WEIGHTS=/data/navera/STHN/weights/one_stage/model.safetensors
# Model caches (DINOv2). Pre-fill them: the vehicle may boot without internet.
TORCH_HOME=/data/navera/torch_cache
# Celestial pipeline, offline data (NAVERA never downloads in operation):
# IERS-A Earth-orientation table (UT1-UTC, polar motion) — fetched before departure with
# navera_tools/fetch_iers.py (or carried in a mission bundle: navera_tools/mission_bundle.py).
# Missing or unreadable: astropy's bundled IERS-B table is extrapolated (UT1-UTC stays under
# 0.9 s: < 0.4 km of position error) and the celestial fix still works. Read by
# cn_pkg celestial_math.py at start; default ~/navera_data/iers/finals2000A.all of the
# service user (/home/navera/navera_data/iers/finals2000A.all).
#NAVERA_IERS_FILE=/data/navera/iers/finals2000A.all
# Star catalogue for the all-sky star identification (cn_subscriber allsky_catalogue), e.g.
# a mission bundle's celestial/bsc5_mag4.5.csv. Empty/unset: the bright-star list shipped
# with cn_pkg.
#NAVERA_STAR_CATALOGUE=/data/navera/bundles/<mission>/celestial/bsc5_mag4.5.csv

# ── Mission maps (page /mission) ────────────────────────────────────────────
# Where the satellite maps of routes are generated (one folder per route). The page's
# "Activate" points DAY_DATASET_DIR at one of them (in /var/lib/navera/settings.env).
NAVERA_AREAS_DIR=/data/navera/areas
# Tiles of a route missing from NAVERA_MBTILES are downloaded from this source when set
# (an XYZ template with {z} {x} {y}; internet needed while generating). Empty = onboard
# map only. The imagery provider's licence must allow storing its tiles offline in a
# product: check it before setting this (docs/VALIDATION_STATUS.md, limitation 5). Esri
# World Imagery (server.arcgisonline.com) does NOT allow it: development only
# (docs/research/map_licensing_2026-10-21.md).
NAVERA_TILE_URL=
NAVERA_TILE_CACHE=/data/navera/areas/downloaded_tiles.mbtiles

# ── Web interface (navera-web, port 8181) ──────────────────────────────────
# Token required by every control action (mission start, /mission changes), sent in
# the X-Navera-Token header. Empty = the web interface is read-only. After 5 wrong codes
# in 60 s an address is refused for 60 s.
# Generate one with:  openssl rand -hex 16
NAVERA_WEB_TOKEN=
# HTTPS (recommended whenever a token is set: over plain HTTP the token crosses the
# network in clear). Both empty = plain HTTP. Self-signed certificate for the box
# (browsers will ask to trust it once):
#   sudo openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=navera" \
#     -keyout /etc/navera/tls.key -out /etc/navera/tls.crt
#   sudo chown navera:navera /etc/navera/tls.key && sudo chmod 600 /etc/navera/tls.key
NAVERA_TLS_CERT=
NAVERA_TLS_KEY=
# Port of the operator view / dashboard. Keep 8181 on a box; another value only for a
# staged test beside a running box (deploy/stage_check.sh).
#NAVERA_WEB_PORT=8181
# Network the web page listens on (deploy/systemd/navera_boot_lib.sh::navera_web_host):
#   empty = every network; localhost = this box only; iface:<name> = the IPv4 address of that
#   interface (the vehicle network, e.g. iface:eth0; waited for up to NAVERA_WEB_HOST_WAIT_S,
#   default 30 s); or an IPv4 address. Anything unusable = 127.0.0.1 (closed, never wider).
NAVERA_WEB_HOST=
#NAVERA_WEB_HOST_WAIT_S=30

# ── Delivered (product) box: deploy/install.sh --product (deploy/README.md §13) ──
# Set to 1 by install.sh --product (also: NAVERA_PRODUCT_MODE=1 sudo -E deploy/install.sh).
NAVERA_PRODUCT_MODE=0
# SSH on a product box: keys (keys only, no password, no root login) or off (no SSH server).
NAVERA_PRODUCT_SSH=keys
# Services disabled on a product box (space-separated; empty = the list in
# deploy/product/apply_product.sh: avahi, bluetooth, ModemManager, cups, apport, apt timers...)
NAVERA_PRODUCT_DISABLE=
# Firewall (deploy/product/navera_firewall.sh, iris-firewall.service; read from THIS file only).
# Open: the web port, SSH (keys mode), a listening MAVLink port of NAVERA_VEHICLE_MAVLINK_URL /
# NAVERA_MAVLINK_URL (udpin:/udp:/tcpin:), the ROS 2 DDS ports when ROS_LOCALHOST_ONLY is not 1.
# More ports (comma-separated, ranges a-b) and the sources allowed (CIDR, the vehicle network;
# empty = any):
NAVERA_FW_ALLOW_TCP=
NAVERA_FW_ALLOW_UDP=
NAVERA_FW_ALLOW_FROM=
# Files checked at boot and moved aside when damaged by a power cut (navera_boot_envcheck.sh;
# default: settings.env and discovered.env of NAVERA_STATE_DIR):
#NAVERA_ENVCHECK_FILES=

# --- Access (deploy/README.md §14; set by deploy/product/apply_product.sh) ---
# On the client's Wi-Fi when it can (entered once on the setup page), else the setup Wi-Fi —
# the same name and password on every box (the access card's QR code).
#NAVERA_HOTSPOT=1
#NAVERA_WIFI_SSID=NAVERA
#NAVERA_WIFI_PASSWORD=navera-iris
#NAVERA_WIFI_IFACE=
#NAVERA_WIFI_ADDRESS=10.42.0.1/24
#NAVERA_WIFI_CHANNEL=6
#NAVERA_WIFI_JOIN_S=45
#NAVERA_WIFI_RETRY_S=300
#NAVERA_PORTAL_PORT=8182
# Control without the code from these networks (comma-separated): "hotspot" = the box's own setup
# hotspot (NAVERA_WIFI_ADDRESS subnet, only while the hotspot is up; the product default),
# "wifi" = every network of the box's Wi-Fi card (the client's Wi-Fi it joined too), or CIDRs
# (100.64.0.0/10 = the Tailscale maintenance VPN). Elsewhere the control code is asked.
#NAVERA_WEB_TRUST_NETS=hotspot
