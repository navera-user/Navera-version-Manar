# NAVERA site settings — copy to /etc/navera/navera.env and adapt.
# Read by every NAVERA systemd unit (EnvironmentFile=). Any shell used to
# inspect the live system must load the same file, or it will not see the
# nodes:   set -a; . /etc/navera/navera.env; set +a

# ── ROS 2 network isolation ────────────────────────────────────────────────
# A domain ID of its own keeps other ROS 2 machines on the same network (a
# developer laptop running navera_tools/sensor_sim.py, another vehicle) from
# publishing into this box's estimator.
ROS_DOMAIN_ID=42
# DDS over loopback only: the nodes all run on this box, and the operator
# reaches it over HTTP (web bridge), not DDS. Also avoids late-joining nodes
# missing each other when Wi-Fi comes up after boot.
ROS_LOCALHOST_ONLY=1

# ── Pipeline and devices ───────────────────────────────────────────────────
# Which vision pipeline the web bridge follows: day | night | cn. Enable the
# matching service (only one pipeline runs at a time; see deploy/README.md).
NAVERA_PIPELINE=day
NAVERA_GPS_PORT=/dev/ttyTHS1
NAVERA_GPS_BAUD=9600

# ── Output to the vehicle's autopilot (navera-output.service) ─────────────
# NMEA GPS emulation on a serial port and/or MAVLink GPS_INPUT. Empty = off.
# Forwarding vision/celestial positions is configured in the package's
# config/vehicle_output.yaml (off by default; see navera_output/README.md).
NAVERA_NMEA_PORT=
NAVERA_NMEA_BAUD=9600
NAVERA_MAVLINK_URL=

# ── Data (large files, not in git) ─────────────────────────────────────────
NAVERA_MBTILES=/data/navera/sousse_satellite.mbtiles
DAY_DATASET_DIR=/data/navera/day_dataset
NAVERA_STHN_DIR=/data/navera/STHN
NAVERA_STHN_WEIGHTS=/data/navera/STHN/weights/one_stage/model.safetensors
# Thermal camera horizontal field of view (degrees) — REQUIRED for night positions.
# Each thermal frame is scaled to the map from it and the frame altitude.
NAVERA_THERMAL_HFOV_DEG=
# ── Vehicle ─────────────────────────────────────────────────────────────────
# Maximum speed of THIS vehicle, km/h (4-1890) — set it at installation.
# NAVERA refuses any position the vehicle could not have reached at this speed
# (GPS spoofing jump, false vision match): the estimator's GPS plausibility gate
# and the day/night vision motion gates all use it. Too low: real positions of
# a fast vehicle are refused; too high: spoofing goes unnoticed longer.
# Rule of thumb: cruise speed + 50 % (tailwind included). Examples: multirotor
# 108, boat 72, ground robot 36, fixed-wing 250, fast aircraft 1200.
# Unset: each node keeps its own default (estimator 360, vision 108) and logs
# a warning. An invalid value stops the node with an explicit error.
NAVERA_MAX_SPEED_KMH=

# Model caches (DINOv2). Pre-fill them: the vehicle may boot without internet.
TORCH_HOME=/data/navera/torch_cache

# ── Web control ────────────────────────────────────────────────────────────
# Token required to start/restart a mission from the dashboard (header
# X-Navera-Token). Leave empty to make the web interface read-only.
# Generate one with:  openssl rand -hex 16
NAVERA_WEB_TOKEN=

# HTTPS for the web interface (optional). Both empty = plain HTTP. To create a
# self-signed certificate for the box (browsers will ask to trust it once):
#   sudo openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=navera" \
#     -keyout /etc/navera/tls.key -out /etc/navera/tls.crt
#   sudo chown navera:navera /etc/navera/tls.key && sudo chmod 600 /etc/navera/tls.key
NAVERA_TLS_CERT=
NAVERA_TLS_KEY=
