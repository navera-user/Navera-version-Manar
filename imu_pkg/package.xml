<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imu_pkg</name>
  <version>0.0.1</version>
  <description>NAVERA IMU sensor driver — BNO085 9-DoF (on-chip fusion) over I2C, publishing sensor_msgs/Imu.</description>
  <maintainer email="navera@example.com">Navera</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <exec_depend>navera_common</exec_depend>
  <depend>launch</depend>
  <depend>launch-ros</depend>
  <depend>sensor_msgs</depend>

  <!-- Python deps installed via pip (no rosdep key exists for them):
       Jetson.GPIO>=2.1.12, adafruit-blinka, adafruit-circuitpython-bno08x.
       Provided by Dockerfile.navera in the container, and on the host for the
       navera-imu systemd service. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
