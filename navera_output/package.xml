<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navera_output</name>
  <version>0.3.0</version>
  <description>NAVERA output to the vehicle: NMEA GPS emulation and MAVLink GPS_INPUT</description>
  <maintainer email="contact@iris-systems.tn">IRIS Systems</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>navera_msgs</exec_depend>
  <exec_depend>navera_common</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- pymavlink: pip (not in rosdep for Humble) -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
