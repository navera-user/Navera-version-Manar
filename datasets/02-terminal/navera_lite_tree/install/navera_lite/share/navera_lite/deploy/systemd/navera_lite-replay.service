# navera_lite-replay.service — replay of a recorded flight (bench tests) (course example)
[Unit]
Description=NAVERA Lite replay of a recorded flight (bench tests)
PartOf=navera_lite.target

[Service]
Type=simple
User=navera_lite
Group=navera_lite
EnvironmentFile=-/etc/navera_lite/navera_lite.env
ExecStart=/usr/bin/python3 -m navera_lite.ros.replay_node --ros-args --params-file /etc/navera_lite/navera_lite.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=navera_lite.target
