# navera_lite.env.example — site settings of one NAVERA Lite box.
# Copy to /etc/navera_lite/navera_lite.env and edit. One NAME=value per line, no spaces around =.
# Every service reads this file (EnvironmentFile= in its unit) and gets these as environment variables.
ROS_DOMAIN_ID=42
ROS_LOCALHOST_ONLY=1
NAVERA_LITE_MAP=/data/map.mbtiles
NAVERA_LITE_VEHICLE=drone
