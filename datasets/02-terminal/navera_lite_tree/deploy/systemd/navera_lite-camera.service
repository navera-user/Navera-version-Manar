# navera_lite-camera.service — camera reader (course example)
[Unit]
Description=NAVERA Lite camera reader
PartOf=navera_lite.target

[Service]
Type=simple
User=navera_lite
Group=navera_lite
# /dev/video0 is root:video 0660
SupplementaryGroups=video
EnvironmentFile=-/etc/navera_lite/navera_lite.env
ExecStart=/usr/bin/python3 -m navera_lite.ros.camera_node --ros-args --params-file /etc/navera_lite/navera_lite.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=navera_lite.target
