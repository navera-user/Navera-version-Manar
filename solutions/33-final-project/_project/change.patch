diff --git a/navera_lite/arbiter.py b/navera_lite/arbiter.py
index ff378a0..81a6770 100644
--- a/navera_lite/arbiter.py
+++ b/navera_lite/arbiter.py
@@ -132,6 +132,17 @@ def pick(cands, current, since, now_s, cfg):
 
 
 # from mission 29 — finished: read it, use it, do not change it
+def aged_sigma(sigma_m, age_s, speed_mps):
+    """The σ (m) a fix states once it is age_s old: the vehicle has moved up to speed_mps × age_s since it was
+    measured, added to the source's own σ as an independent error: √(σ² + (speed × age)²). None stays None
+    (a source that states nothing still states nothing); a negative age counts as 0.
+    Example: aged_sigma(15.0, 2.0, 10.0) → 25.0
+    """
+    if sigma_m is None:
+        return None
+    return math.hypot(sigma_m, speed_mps * max(0.0, age_s))
+
+
 class Arbiter:
     """The judge of NAVERA Lite (lesson 29). Feed it with receive(est, now_s) on every arrival; ask it with
     step(now_s) on every arrival and at tick_hz. Its memory is in its attributes (see the top of this file).
@@ -221,6 +232,6 @@ class Arbiter:
         if winner is None:
             return Decision("NO_FIX", None, None, None, no_fix_reason(sources), sources, switched)
         est = self.latest[winner]
-        sigma = stated_sigma(est, self.cfg)
+        sigma = aged_sigma(stated_sigma(est, self.cfg), now_s - est.stamp_s, float(self.cfg["age_speed_mps"]))
         state, words = classify(sigma, self.cfg)
         return Decision(state, winner, est, sigma, f"{winner}: {words}", sources, switched)
