diff --git a/gps_pkg/test/test_gga_validation.py b/gps_pkg/test/test_gga_validation.py
new file mode 100644
index 0000000..6c3a86e
--- /dev/null
+++ b/gps_pkg/test/test_gga_validation.py
@@ -0,0 +1,40 @@
+"""Unit tests for gps_node.fix_problem(): which GGA sentences are usable fixes."""
+import pynmea2
+
+from gps_pkg.nodes.gps_node import MIN_SATELLITES, fix_problem
+
+
+def gga(qual="1", sats="08", lat="3544.04006", lon="01034.55091"):
+    body = f"GPGGA,141621.00,{lat},N,{lon},E,{qual},{sats},0.9,25.0,M,33.0,M,,"
+    cs = 0
+    for ch in body:
+        cs ^= ord(ch)
+    return pynmea2.parse(f"${body}*{cs:02X}", check=True)
+
+
+def problem_of(msg):
+    sats = int(msg.num_sats) if msg.num_sats else None
+    return fix_problem(int(msg.gps_qual or 0), bool(msg.lat) and bool(msg.lon), sats)
+
+
+def test_a_normal_fix_is_usable():
+    assert problem_of(gga()) == ""
+
+
+def test_no_fix_and_dead_reckoning_are_refused_as_before():
+    assert problem_of(gga(qual="0")).startswith("no GPS fix")
+    assert "non-satellite" in problem_of(gga(qual="6"))
+
+
+def test_fewer_than_four_satellites_is_refused():
+    assert MIN_SATELLITES == 4
+    assert "only 3 satellites" in problem_of(gga(sats="03"))
+    assert problem_of(gga(sats="04")) == ""
+
+
+def test_unknown_satellite_count_is_not_judged():
+    assert problem_of(gga(sats="")) == ""
+
+
+def test_missing_position_is_refused():
+    assert problem_of(gga(lat="", lon="")).startswith("no GPS fix")
