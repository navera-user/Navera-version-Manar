[Service]
User=shadow-team
Environment=NAVERA_FIELD_PLAIN=1
Environment=NAVERA_FIELD_PORT=8444
Environment=NAVERA_FIELD_PUBLIC_URL=https://navera-academy.tail27d06f.ts.net:8443
ExecStart=/home/shadow-team/Navera/navera_tools/field/run_field.sh
