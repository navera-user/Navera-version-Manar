<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_pkg</name>
  <version>0.0.1</version>
  <description>Camera / frame source for NAVERA — replaces PC-Nour. Live CSI/USB camera or CSV replay, published on ROS2 topics with optional legacy HTTP bridge.</description>
  <maintainer email="contact@iris-systems.tn">IRIS Systems</maintainer>
  <license>Proprietary</license>


  <depend>rclpy</depend>
  <exec_depend>navera_common</exec_depend>
  <depend>navera_msgs</depend>
  <depend>launch</depend>
  <depend>launch-ros</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- the Insta360 kit (insta360_node.py): USB Android mode and its H.264 key frames -->
  <exec_depend>python3-usb</exec_depend>
  <exec_depend>python3-av</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
