<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtc_pkg</name>
  <version>0.0.1</version>
  <description>NAVERA RTC driver — DS3231 (TCXO) over I2C, publishing sensor_msgs/TimeReference for the celestial pipeline.</description>
  <maintainer email="contact@iris-systems.tn">IRIS Systems</maintainer>
  <license>Apache-2.0</license>


  <depend>rclpy</depend>
  <exec_depend>navera_common</exec_depend>
  <depend>launch</depend>
  <depend>launch-ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Python deps installed via pip (no rosdep key exists for them):
       adafruit-blinka, adafruit-circuitpython-ds3231, adafruit-register.
       Provided by Dockerfile.navera in the container, and on the host for the
       navera-rtc systemd service. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
