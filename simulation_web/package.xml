<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulation_web</name>
  <version>0.0.1</version>
  <description>Web-based simulation interface for NVIDIA Isaac with flight logging and mapping visualization</description>
  <maintainer email="contact@iris-systems.tn">IRIS Systems</maintainer>
  <license>Proprietary</license>

  
  <depend>rclpy</depend>
  <exec_depend>navera_common</exec_depend>
  <depend>navera_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch-ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>camera_pkg</exec_depend>
  <exec_depend>day_pkg</exec_depend>
  <exec_depend>night_pkg</exec_depend>
  <exec_depend>cn_pkg</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
