#!/bin/bash
# navera_lite_arbiter — a PRETEND arbiter for the lab-02 bench box (the real one is your mission 29).
# Once per second it writes its decision in box/log/decisions.log, in the ROS 2 console format.
# It listens to the GPS topic named in its settings file (--params-file FILE).
BOX="$(cd "$(dirname "$0")/.." && pwd)"
NAME=navera_lite_arbiter
. "$BOX/bin/_common.sh"
params="$2"
pidfile="$BOX/run/arbiter-$$.pid"
echo $$ > "$pidfile"
topic="$(grep -o 'gps_topic: *[^ ]*' "$params" 2> /dev/null | awk '{print $2}')"
trap 'say "received SIGTERM, shutting down cleanly"; rm -f "$pidfile"; exit 0' TERM
trap 'say "received SIGINT, shutting down cleanly"; rm -f "$pidfile"; exit 0' INT
say "started"
while true; do
    now="$(date +%s.%N)"
    if [ "$topic" = "/navera_lite/fix/gps" ]; then
        echo "[INFO] [$now] [navera_lite_arbiter]: state FIX source=gps sigma 4.0 m" >> "$BOX/log/decisions.log"
    else
        echo "[WARN] [$now] [navera_lite_arbiter]: state NO_FIX: no source usable (gps: no message on ${topic:-?})" \
            >> "$BOX/log/decisions.log"
    fi
    sleep 1
done
