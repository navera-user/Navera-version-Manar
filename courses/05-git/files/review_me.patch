From 8cdaaaf2c3dc9066697f90d33bf247523263e93f Mon Sep 17 00:00:00 2001
From: Kenji Sato <kenji.sato@example.com>
Date: Thu, 1 Oct 2026 10:00:00 +0100
Subject: [PATCH] fix(estimator): fewer false GPS refusals; geo: use
 EARTH_RADIUS_M

Flight tests near Monastir showed the GPS gate refusing good fixes after
short outages. Raise the jump margin. Also use the module constant in
haversine_m() instead of a repeated literal.
---
 navera_common/navera_common/geo.py                             | 2 +-
 navera_estimator/navera_estimator/config/estimator_params.yaml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/navera_common/navera_common/geo.py b/navera_common/navera_common/geo.py
index c6cd5d9..364c8c5 100644
--- a/navera_common/navera_common/geo.py
+++ b/navera_common/navera_common/geo.py
@@ -59,4 +59,4 @@ def haversine_m(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
     p1, p2 = math.radians(lat1), math.radians(lat2)
     a = (math.sin((p2 - p1) / 2) ** 2
          + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2)
-    return 2 * 6_371_000.0 * math.asin(math.sqrt(min(1.0, a)))
+    return 2 * EARTH_RADIUS_M * math.asin(math.sqrt(min(1.0, a)))
diff --git a/navera_estimator/navera_estimator/config/estimator_params.yaml b/navera_estimator/navera_estimator/config/estimator_params.yaml
index 96f1a70..c51d206 100644
--- a/navera_estimator/navera_estimator/config/estimator_params.yaml
+++ b/navera_estimator/navera_estimator/config/estimator_params.yaml
@@ -36,7 +36,7 @@ estimator_node:
     # gps_jump_margin_m is refused until it becomes reachable. Set per vehicle
     # with NAVERA_MAX_SPEED_KMH in /etc/navera/navera.env (km/h, overrides this).
     max_speed_mps: 100.0
-    gps_jump_margin_m: 50.0
+    gps_jump_margin_m: 5000.0     # fewer false GPS refusals in flight tests
 
     # FIX (green) requires a known covariance whose horizontal sigma is at most
     # this; a larger stated uncertainty (e.g. GPS HDOP 20) is DEGRADED.
-- 
2.34.1

